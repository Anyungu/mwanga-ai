# For local dev / testing on localhost
localhost {
    # Route backend API & MCP endpoints directly to FastAPI
    handle /api/* {
        rate_limit {
            zone origin {
                key    {http.request.header.Origin}
                events 600
                window 1m
            }
            zone ip {
                key    {remote_host}
                events 60
                window 1m
            }
        }
        uri strip_prefix /api
        reverse_proxy core:8000
    }

    # Route OpenAPI / Swagger docs
    handle /docs* {
        reverse_proxy core:8000
    }

    handle /openapi.json {
        reverse_proxy core:8000
    }

    # Route everything else to TanStack Start Admin UI
    handle {
        reverse_proxy admin-ui:3000
    }
}
